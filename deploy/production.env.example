# Paste into Easypanel's environment editor, not into Git with real values.
APP_NAME=Horizonte
APP_ENV=production
APP_DEBUG=false
APP_URL=
APP_KEY=
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=es
# Actual proxy IPs / CIDRs in the private network, comma separated. No '*'.
TRUSTED_PROXIES=
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Use verify-full and the provider's CA when connecting to a managed external DB.
DB_SSLMODE=prefer
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_DAILY_LIMIT=100
