APP_NAME="Horizonte"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Complete with real PostgreSQL connection details. No default credentials.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# Optional, dedicated PostgreSQL test database, with a name ending in _test.
# Never point these values at development or production.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_SSLMODE=prefer

# Sessions and cache use files; the catalogue and inboxes require PostgreSQL.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"

# Server-side only. Create your own key in Google AI Studio; never use VITE_ here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CHAT_DAILY_LIMIT=100
CHAT_RETENTION_DAYS=30

# Production reverse proxy IPs / CIDRs only. Leave empty for local development.
TRUSTED_PROXIES=
